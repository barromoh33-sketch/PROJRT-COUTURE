# ============================================
# 🗄️ BASE DE DONNÉES
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/projrt_couture"

# ============================================
# 🔐 AUTHENTIFICATION & SÉCURITÉ
# ============================================
NEXTAUTH_SECRET="your-secret-key-here-min-32-characters"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# 📧 SERVICES DE NOTIFICATIONS
# ============================================

# Email (SendGrid)
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="noreply@atelier.app"

# SMS (Twilio ou Africastalking)
TWILIO_ACCOUNT_SID="your-twilio-sid"
TWILIO_AUTH_TOKEN="your-twilio-token"
TWILIO_PHONE_NUMBER="+1234567890"

# WhatsApp (WhatsApp Business API)
WHATSAPP_BUSINESS_ACCOUNT_ID="your-whatsapp-account-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"

# ============================================
# 💳 PAIEMENTS
# ============================================

# Wave
WAVE_API_KEY="your-wave-api-key"
WAVE_BUSINESS_ID="your-business-id"

# Orange Money
ORANGE_MONEY_API_KEY="your-orange-money-key"
ORANGE_MONEY_SECRET="your-orange-money-secret"

# MTN Mobile Money
MTN_MOMO_API_KEY="your-mtn-api-key"
MTN_MOMO_SUBSCRIPTION_KEY="your-subscription-key"

# ============================================
# 🔐 CRON JOBS
# ============================================
CRON_SECRET="your-cron-secret-for-vercel"

# ============================================
# 🌍 ENVIRONNEMENT
# ============================================
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000"
